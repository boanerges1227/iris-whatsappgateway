# Optional override. Default: InterSystems IRIS for Health Community 2026.2.
IRIS_IMAGE=intersystems/irishealth-community:2026.2

# Mock secrets; keep these equal to WhatsApp.Production.Demo adapter settings.
# Changing these env values alone does not update saved IRIS Production settings.
META_APP_SECRET=demo-app-secret
VERIFY_TOKEN=demo-verify-token
TWILIO_AUTH_TOKEN=demo-twilio-token

# Real Meta WhatsApp Cloud API (optional)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_API_VERSION=v21.0
